---
// The connection map. mode "page": the map pages (/map/, /map/<song>/), which on a computer fill the window under the
// header with a side panel for the dot you click (step 5); "thread": under a thread's cards; "small": a song page's
// map of its neighbours, shown from 1100 px only (step 4).
import { songs, links, eras, eraOfSong, songById, albumById, url, BASE } from "../lib/data";
import MapPanel from "./MapPanel.astro";
interface Props { focus?: string | null; mode?: "page" | "thread" | "small" }
const { focus = null, mode = "page" } = Astro.props;
const connected = new Set(links.flatMap((l) => [l.from, l.to]));
const nodes = songs.filter((s) => connected.has(s.id)).map((s) => ({ id: s.id, title: s.title, by: s.by && s.by !== "Bob Dylan" ? s.by : null,
  album: s.album ? albumById.get(s.album)?.title ?? null : null, year: s.year, era: eraOfSong(s).id }));
const edges = links.filter((l) => songById.has(l.from) && songById.has(l.to)).map((l) => ({ source: l.from, target: l.to, kind: l.kind }));
const f = focus ? songById.get(focus) : null;
---
<div class:list={["mapwrap", `m-${mode}`]}>
  {mode !== "small" && (
    <div class="top">
      <div><p class="kicker">The map · {nodes.length} songs, {edges.length} connections</p>
        <h1 class="display mt">{f ? f.title : "Every connection"}</h1>
        {/* on a computer the Cards | Map toggle is gone, so the map page leads to the cards here (question 4, answered A) */}
        {f && mode === "page" && <a class="desk thread-from" href={url.threadFrom(f.id)}>A thread from {f.title} ›</a>}</div>
      {f && <div class="toggle"><a class="tocards" href={url.threadFrom(f.id)}>Cards</a><span class="on">Map</span></div>}
    </div>
  )}
  {mode !== "small" && <p class="soft small"><span class="touch">Every song is a dot and every connection a line. Drag to move, pinch to zoom, tap a dot to open its song.</span><span class="mouse">Every song is a dot and every connection a line. Drag to move, Ctrl + scroll or + / − to zoom, {mode === "page" ? "click a dot to see it beside the map, double-click to open it" : "click a dot to open its song"}.</span></p>}
  <div class="stage">
    <div class="chart">
      <div class="map" data-map={JSON.stringify({ nodes, edges })} data-focus={focus ?? ""} data-base={BASE} data-mode={mode}></div>
      <span class="compass" aria-hidden="true">N</span>
      <div class="zoom"><button type="button" class="zoom-in" aria-label="Zoom in">+</button><button type="button" class="zoom-out" aria-label="Zoom out">−</button></div>
      <p class="hover" hidden></p>
    </div>
    {mode === "page" && <MapPanel focus={focus} />}
  </div>
  {mode !== "small" && (
    <ul class="legend" aria-label="Dot colours by era">
      {eras.map((e) => <li data-era={e.id} data-filter={e.id}><i></i>{e.title}</li>)}
    </ul>
  )}
</div>
<script>
  import { mountMap, type MapApi } from "../islands/map";
  type Row = { t: string; by: string | null; album: string | null; year: number | null; era: string; eraTitle: string; cover: string | null; coverEra: string;
    preview: string | null; h: string; conns: { w: string; id: string; t: string; by: string | null }[] };
  let panelRows: Promise<Record<string, Row>> | null = null;

  function fillPanel(panel: HTMLElement, api: MapApi, id: string | null) {
    const sel = panel.querySelector<HTMLElement>(".sel")!, empty = panel.querySelector<HTMLElement>(".empty")!;
    if (!id) { sel.hidden = true; empty.hidden = false; return; }
    panelRows ??= fetch(panel.dataset.src!).then((r) => r.json());
    panelRows.then((rows) => {
      const r = rows[id]; if (!r) return;
      const q = <T extends Element = HTMLElement>(s: string) => panel.querySelector<T>(s)!;
      panel.dataset.era = r.era; panel.dataset.selected = id;
      q(".p-era").textContent = r.eraTitle; q(".p-year").textContent = r.year ? String(r.year) : "Traditional";
      q(".p-title").textContent = r.t; q(".p-by").textContent = r.by ?? r.album ?? "";
      q(".p-cover").dataset.era = r.coverEra; q(".p-at").textContent = r.album ?? r.t;
      const img = q<HTMLImageElement>(".p-cover img");
      if (r.cover) { img.src = r.cover; img.alt = `Cover of ${r.album}`; img.onerror = () => img.removeAttribute("src"); } else img.removeAttribute("src");
      q(".p-preview").textContent = r.preview ?? "";
      q(".p-cn").textContent = r.conns.length === 1 ? "1 connection" : `${r.conns.length} connections`;
      const ul = q(".p-conns"); ul.replaceChildren();
      for (const c of r.conns) {
        const li = document.createElement("li"), a = document.createElement("a");
        a.href = `${panel.dataset.base ?? "/"}song/${c.id}/`; a.dataset.id = c.id;
        const w = document.createElement("span"); w.className = "w"; w.textContent = c.w;
        const t = document.createElement("span"); t.textContent = c.by && c.by !== "traditional" ? `${c.t} · ${c.by}` : c.t;
        a.append(w, t); li.append(a); ul.append(li);
      }
      q<HTMLAnchorElement>(".p-open").href = r.h;
      empty.hidden = true; sel.hidden = false;
    });
  }

  function setup() {
    for (const el of document.querySelectorAll<HTMLElement>(".map[data-map]")) {
      // a map that is not showing (the song page's small map on a phone) is laid out once it shows
      if (el.dataset.ready || !el.clientWidth) continue;
      el.dataset.ready = "1";
      const wrap = el.closest(".mapwrap")!;
      const panel = wrap.querySelector<HTMLElement>(".mappanel");
      let api: MapApi;
      api = mountMap(el, JSON.parse(el.dataset.map!), el.dataset.focus || null, el.dataset.base!, {
        selectable: !!panel, onSelect: (id) => panel && fillPanel(panel, api, id),
        // on a computer, too, a map opens on the song's neighbourhood (plan 2026-10-07-desktop); /map/ shows everything
        near: matchMedia("(min-width: 1100px)").matches,
      });
      (el as HTMLElement & { mapApi?: MapApi }).mapApi = api;
      if (panel) {
        panel.dataset.base = el.dataset.base;
        // on a computer the panel opens on the song the page is about
        if (panel.dataset.focus && matchMedia("(min-width: 1100px)").matches) api.select(panel.dataset.focus);
        // the legend becomes a filter: click an era to light only its dots
        if (matchMedia("(min-width: 1100px)").matches) {
          let on: string | null = null;
          for (const li of wrap.querySelectorAll<HTMLElement>(".legend li")) {
            li.setAttribute("role", "button"); li.tabIndex = 0; li.setAttribute("aria-pressed", "false");
            const go = () => {
              on = on === li.dataset.filter ? null : li.dataset.filter!;
              api.filter(on);
              wrap.querySelectorAll<HTMLElement>(".legend li").forEach((x) => { x.setAttribute("aria-pressed", String(x.dataset.filter === on)); x.classList.toggle("off", !!on && x.dataset.filter !== on); });
            };
            li.addEventListener("click", go);
            li.addEventListener("keydown", (e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); go(); } });
          }
        }
      }
    }
    // Cards goes back to the thread you came from (?thread=<id>), else to a thread made from this song
    const from = new URLSearchParams(location.search).get("thread");
    const cards = document.querySelector<HTMLAnchorElement>(".tocards");
    const base = document.querySelector<HTMLElement>(".map[data-base]")?.dataset.base;
    if (from && cards && base) cards.href = `${base}thread/${from}/`;
  }
  setup();
  document.addEventListener("astro:page-load", setup);
  matchMedia("(min-width: 1100px)").addEventListener("change", setup);
</script>
<style>
  .thread-from { display: inline-block; margin-top: 8px; font: 600 15px/1.3 var(--label); color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .top { display: flex; justify-content: space-between; align-items: flex-end; gap: 12px; }
  .top > div { min-width: 0; }
  .mt { font-size: clamp(28px, 8vw, 44px); }
  .small { font-size: 15px; }
  .small .mouse { display: none; }
  @media (hover: hover) and (pointer: fine) { .small .mouse { display: inline; } .small .touch { display: none; } }
  /* the chart: always a night-blue sheet with a faint graticule, so every era's dot colour reads the same way;
     the page's era dresses its frame (src/themes/<era>.css styles .chart) */
  .chart { position: relative; margin-top: 4px; }
  .map { height: 64dvh; touch-action: none; overflow: hidden; color: #f1ead9;
    background:
      radial-gradient(ellipse 70% 55% at 50% 45%, rgba(120,150,210,.16), transparent 70%),
      linear-gradient(rgba(241,234,217,.05) 1px, transparent 1px) 0 0 / 40px 40px,
      linear-gradient(90deg, rgba(241,234,217,.05) 1px, transparent 1px) 0 0 / 40px 40px,
      #0f1524; }
  .compass { position: absolute; right: 12px; top: 10px; width: 30px; height: 30px; display: grid; place-items: center; pointer-events: none;
    font: 700 12px/1 var(--mono); color: #f1ead9; border: 1px solid rgba(241,234,217,.5); border-radius: 50%; }
  .compass::before { content: ""; position: absolute; top: -6px; left: 50%; border: 5px solid transparent; border-bottom-color: #f1ead9; translate: -50% -50%; }
  /* + and −, from 768 px (a phone pinches) */
  .zoom { position: absolute; right: 10px; bottom: 10px; display: none; flex-direction: column; gap: 6px; }
  .zoom button { width: 44px; height: 44px; display: grid; place-items: center; padding: 0; cursor: pointer; font: 700 22px/1 var(--mono);
    color: #f1ead9; background: rgba(15,21,36,.85); border: 1px solid rgba(241,234,217,.5); }
  .zoom button:hover { background: #0f1524; border-color: #f1ead9; }
  /* the hover label: title · album or artist · year, beside the dot */
  .hover { position: absolute; z-index: 4; margin: 0; translate: 0 -50%; pointer-events: none; white-space: nowrap; max-width: 60%; overflow: hidden; text-overflow: ellipsis;
    padding: 5px 9px; font: 600 13px/1.2 var(--body); color: #0f1524; background: #f1ead9; box-shadow: 0 2px 8px rgba(0,0,0,.4); }
  .hover.flip { translate: calc(-100% - var(--dw, 30px)) -50%; }
  .map :global(svg) { width: 100%; height: 100%; display: block; cursor: grab; }
  .map :global(svg.dragging) { cursor: grabbing; }
  .map :global(a) { cursor: pointer; }
  .map :global(.hit) { fill: transparent; }
  .map :global(.edge) { stroke: #c9c2b0; stroke-width: 1.1; opacity: .28; }
  .map :global(.edge.near) { stroke: #f1ead9; stroke-width: 1.8; opacity: .75; }
  .map :global(.edge.lit) { stroke: #fff; stroke-width: 2.4; opacity: 1; }
  .map :global(.dot) { fill: var(--dot); stroke: #0f1524; stroke-width: 2; transition: r .15s; }
  .map :global(.dot.focus) { stroke: #fff; stroke-width: 3; }
  .map :global(a.lit .dot), .map :global(a:hover .dot) { stroke: #fff; stroke-width: 3; opacity: 1; }
  .map :global(a.sel .dot) { stroke: #fff; stroke-width: 4; r: 11px; opacity: 1; }
  .map :global(.ring) { fill: none; stroke: var(--dot); stroke-width: 2; stroke-dasharray: 3 4; opacity: .9; transform-box: fill-box; transform-origin: center;
    animation: ring 14s linear infinite; }
  .map :global(.halo) { fill: var(--dot); opacity: .18; }
  .map :global(.dot.far) { opacity: .4; }
  .map :global(a.dim) { opacity: .14; }
  .map :global(svg.filtered .edge) { opacity: .08; }
  .map :global(a:focus-visible .dot) { stroke: #fff; stroke-width: 4; }
  .map :global(text) { font: 600 calc(12.5px / clamp(.6, var(--lk, 1), 1.4)) var(--body); fill: #f1ead9; paint-order: stroke; stroke: #0f1524; stroke-width: 4px; stroke-linejoin: round; }
  .map :global(text.focus) { font: 700 calc(16px / clamp(.6, var(--lk, 1), 1.4)) var(--display-alt, var(--display)); letter-spacing: .02em; }
  @keyframes ring { to { rotate: 360deg; } }
  .legend { list-style: none; display: flex; flex-wrap: wrap; gap: 6px 14px; padding: 12px 0 0; margin: 0; font: 13px/1.3 var(--label);
    letter-spacing: .02em; color: var(--soft); }
  .legend li { display: inline-flex; align-items: center; gap: 6px; }
  .legend i { width: 11px; height: 11px; border-radius: 50%; background: var(--dot); box-shadow: 0 0 0 2px #0f1524; }
  .legend li[role="button"] { cursor: pointer; min-height: 44px; padding: 0 10px; border: 1.5px solid var(--line); }
  .legend li[role="button"]:hover, .legend li[aria-pressed="true"] { border-color: var(--ink); color: var(--ink); }
  .legend li.off { opacity: .45; }

  /* the song page's small map: a computer only */
  .m-small { display: none; }
  @media (min-width: 768px) { .zoom { display: flex; } }
  @media (min-width: 1100px) {
    .m-small { display: block; }
    /* labels stay readable when a wide map is zoomed out to show many songs */
    .map :global(text) { font-size: calc(12.5px / clamp(.42, var(--lk, 1), 1.4)); }
    .m-page .legend { padding-top: 10px; gap: 6px 8px; }
    .m-small .map { height: 300px; }
    /* under a thread's cards: the full width of the content, 520 px tall; the toggle goes, both views show */
    .m-thread .map { height: 520px; }
    .m-thread .toggle, .m-page .toggle { display: none; }
    .m-thread .top { margin-top: 8px; }
    .m-thread .mt { display: none; }
    /* the map page fills the window under the header, its panel beside it */
    .m-page .stage { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 24px; height: calc(100dvh - 336px); min-height: 440px; margin-top: 6px; }
    .m-page .chart { margin: 0; min-height: 0; }
    .m-page .map { height: 100%; }
    .m-page .top { align-items: center; }
  }
</style>
