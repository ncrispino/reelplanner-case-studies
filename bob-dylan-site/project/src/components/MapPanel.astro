---
// The map page's side panel on a computer (step 5, D-038): the song whose dot you clicked, with its era, cover,
// preview and connections, and "Open the song ›". Filled in by MapView's script from /map-panel.json.
import { at } from "../lib/data";
interface Props { focus?: string | null }
const { focus = null } = Astro.props;
---
<aside class="mappanel card" aria-live="polite" data-src={at("/map-panel.json")} data-focus={focus ?? ""}>
  <div class="empty">
    <p class="kicker">The map</p>
    <p class="lead">Click a dot to see its song here. Double-click a dot to open it.</p>
    <p class="soft">Click an era under the map to light only its songs.</p>
  </div>
  <div class="sel" hidden>
    <p class="kicker"><span class="p-era"></span> · <span class="p-year year"></span></p>
    <div class="p-head">
      <figure class="p-cover"><div class="p-drawn"><span class="p-at"></span></div><img alt="" width="250" height="250" /></figure>
      <div><h2 class="p-title"></h2><p class="p-by soft"></p></div>
    </div>
    <p class="p-preview"></p>
    <p class="kicker p-cn"></p>
    <ul class="p-conns"></ul>
    <a class="button accent p-open" href="">Open the song ›</a>
  </div>
</aside>
<style>
  .mappanel { display: none; }
  @media (min-width: 1100px) {
    .mappanel { display: flex; flex-direction: column; gap: 10px; overflow: auto; min-height: 0; margin: 0; }
  }
  .lead { font-size: 18px; margin: 0 0 8px; }
  .sel { display: grid; gap: 10px; align-content: start; }
  .sel[hidden] { display: none; }
  .sel .kicker { margin: 0; }
  .p-head { display: grid; grid-template-columns: 96px 1fr; gap: 14px; align-items: end; }
  .p-cover { position: relative; margin: 0; width: 96px; aspect-ratio: 1; overflow: hidden; }
  .p-cover img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .p-cover img:not([src]) { display: none; }
  .p-drawn { position: absolute; inset: 0; display: flex; align-items: flex-end; padding: 8px; background: var(--texture), var(--accent); color: var(--accent-ink);
    font: var(--display-weight) 13px/1.05 var(--display-alt, var(--display)); text-transform: var(--display-case); overflow: hidden; }
  .p-title { margin: 0; font: var(--display-weight) 28px/1.05 var(--display-alt, var(--display)); font-style: var(--display-style);
    text-transform: var(--display-case); letter-spacing: var(--display-track); overflow-wrap: break-word; }
  .p-by { margin: 4px 0 0; font-size: 15px; }
  .p-preview { margin: 0; font-size: 16px; font-style: italic; }
  .p-conns { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .p-conns :global(a) { display: flex; flex-direction: column; justify-content: center; min-height: 44px; padding: 6px 0; border-bottom: 1px solid var(--line); text-decoration: none; font-size: 15px; }
  .p-conns :global(.w) { font: var(--label-weight) 11px/1.3 var(--label); letter-spacing: var(--label-track); text-transform: var(--label-case); color: var(--soft); }
  .p-open { justify-self: start; margin-top: 6px; }
</style>
