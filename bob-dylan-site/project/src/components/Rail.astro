---
// The context rail (plan 2026-10-07-fuller, step 5, question 1 A): from 1440 px, beside the content (still up to
// --page-max wide, D-036), the era's badge and years, a small timeline of the eras with this page's place lit, and
// quick links (the era, the album, a thread from this song, the map). It stays in place as you scroll. Below 1440 px
// it is not shown (site.css), and the page is as it was.
import { eras, yearsLabel, url, connectionsOf, threadsOf, type Era, type RailProps } from "../lib/data";
const { era, album = null, song = null, year = null, here } = Astro.props as RailProps;
const last = new Date().getFullYear();
const span = (e: Era) => (e.years[1] ?? last) - e.years[0] + 1;
// where this page's year sits inside its era's stretch, 0 to 1
const at = year == null ? null : Math.max(0, Math.min(1, (year - era.years[0]) / Math.max(1, span(era) - 1)));
const links: { label: string; what: string; href: string }[] = [{ label: "The era", what: era.title, href: url.era(era.id) }];
if (album && here !== "album") links.push({ label: "The album", what: album.title, href: url.album(album.id) });
if (song) {
  if (connectionsOf(song.id).length > 0) links.push({ label: "A thread", what: `From ${song.title}`, href: url.threadFrom(song.id) });
  else { const t = threadsOf(song.id)[0]; if (t) links.push({ label: "A thread", what: t.title, href: url.thread(t.id) }); }
}
links.push({ label: "The map", what: song && connectionsOf(song.id).length > 0 ? `${song.title} on the map` : "Every song and its ties", href: url.map(song && connectionsOf(song.id).length > 0 ? song.id : undefined) });
---
<aside class="rail" aria-label="Where this is">
  <a class="badge" href={url.era(era.id)}>
    <span class="kicker year">{yearsLabel(era)}</span>
    <span class="bt">{era.title}</span>
    {year != null && <span class="by year">{here === "album" ? "Released" : here === "moment" ? "In" : "From"} {year}</span>}
  </a>
  <ol class="eras" aria-label="The eras">
    {eras.map((e) => (
      <li class:list={{ on: e.id === era.id }}>
        <a href={url.era(e.id)} aria-current={e.id === era.id ? "true" : undefined}>
          <span class="bar" data-era={e.id} style={`--g:${span(e)}`}>{e.id === era.id && at != null && <i class="pin" style={`--at:${at.toFixed(3)}`}></i>}</span>
          <span class="el">{e.title}</span><span class="ey year">{e.years[0]}</span>
        </a>
      </li>
    ))}
  </ol>
  <nav class="quick" aria-label="Quick links">
    {links.map((l) => <a href={l.href}><span class="ql">{l.label}</span><span class="qw">{l.what}</span></a>)}
  </nav>
</aside>
<style>
  .rail { display: none; }
  @media (min-width: 1440px) {
    .rail { display: flex; flex-direction: column; gap: 28px; position: sticky; top: calc(var(--head-h) + 28px); align-self: start;
      max-height: calc(100dvh - var(--head-h) - 48px); overflow-y: auto; scrollbar-width: thin; padding: 36px 0 24px 48px; font-size: 15px; }
    .badge { display: grid; gap: 6px; padding: 16px 16px 14px; text-decoration: none; color: var(--ink); border-left: 6px solid var(--accent);
      background: color-mix(in srgb, var(--ink) 7%, transparent); }
    .badge:hover .bt { color: var(--accent); }
    .badge .kicker { margin: 0; }
    .bt { font: var(--display-weight) 26px/1.05 var(--display-alt, var(--display)); font-style: var(--display-style); text-transform: var(--display-case);
      letter-spacing: var(--display-track); }
    .by { font: 600 13px/1.2 var(--mono); color: var(--soft); }
    .eras { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
    .eras a { display: grid; grid-template-columns: 34px 1fr auto; align-items: center; gap: 10px; min-height: 26px; text-decoration: none; color: var(--soft); }
    .eras a:hover { color: var(--ink); }
    /* each era a bar sized by its years (as on the time ribbon), in its own colour */
    .bar { position: relative; display: block; height: 8px; width: calc(6px + min(28px, var(--g) * 1px)); background: var(--dot); opacity: .55;
      outline: 1px solid var(--line); }
    .el { font: 13px/1.2 var(--label); letter-spacing: .02em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .ey { font: 12px/1 var(--mono); }
    .on a { color: var(--ink); }
    .on .el { font-weight: 700; }
    .on .bar { opacity: 1; height: 14px; outline: 2px solid var(--ink); }
    .pin { position: absolute; top: -4px; bottom: -4px; left: calc(var(--at) * (100% - 3px)); width: 3px; background: var(--ink); }
    .quick { display: grid; border-top: 1px solid var(--line); }
    .quick a { display: grid; gap: 2px; padding: 10px 2px; min-height: 52px; border-bottom: 1px solid var(--line); text-decoration: none; }
    .ql { font: var(--label-weight) 11px/1.2 var(--label); letter-spacing: var(--label-track); text-transform: var(--label-case); color: var(--soft); }
    .qw { font-size: 15px; line-height: 1.3; }
    .quick a:hover .qw { color: var(--accent); }
    .quick a::after { content: none; }
  }
</style>
